

   BINARY SEARCH - DEBUGGING CHALLENGE

====================================================

Problem:
Identify and fix logical errors in Binary Search.

---------------- BUGGY CODE ----------------

int binarySearchBuggy(vector<int>& arr, int target) {
int low = 0;
int high = arr.size();

while (low < high) {
    int mid = (low + high) / 2;

    if (arr[mid] == target)
        return mid;
    else if (arr[mid] < target)
        low = mid;
    else
        high = mid - 1;
}

return -1;

}

---------------- BUGS IDENTIFIED ----------------

1. high = arr.size() should be arr.size() - 1.
2. low = mid should be mid + 1.
3. while (low < high) should be low <= high.

---------------- CORRECTED CODE ----------------

int binarySearch(vector<int>& arr, int target) {
int low = 0;
int high = arr.size() - 1;

while (low <= high) {
    int mid = low + (high - low) / 2;

    if (arr[mid] == target)
        return mid;
    else if (arr[mid] < target)
        low = mid + 1;
    else
        high = mid - 1;
}

return -1;

}

---------------- MAIN FUNCTION ----------------

int main() {
vector<int> arr = {2, 4, 6, 8, 10, 12};
int target = 10;

cout << "Index: " << binarySearch(arr, target);

return 0;

}

---------------- OUTPUT ----------------

Index: 4

---------------- COMPLEXITY ANALYSIS ----------------

Time Complexity: O(log N)
Space Complexity: O(1)

---------------- CONCEPTS USED ----------------

1. Binary Search
2. STL Vectors
3. Arrays
4. Logical Debugging
5. Time and Space Complexity

Note:
Binary Search works on sorted arrays.

*/

#include <iostream>
#include <vector>
using namespace std;

// Buggy Implementation
int binarySearchBuggy(vector<int>& arr, int target) {
int low = 0;
int high = arr.size();

while (low < high) {
    int mid = (low + high) / 2;

    if (arr[mid] == target)
        return mid;
    else if (arr[mid] < target)
        low = mid;
    else
        high = mid - 1;
}

return -1;

}

// Corrected Implementation
int binarySearch(vector<int>& arr, int target) {
int low = 0;
int high = arr.size() - 1;

while (low <= high) {
    int mid = low + (high - low) / 2;

    if (arr[mid] == target)
        return mid;
    else if (arr[mid] < target)
        low = mid + 1;
    else
        high = mid - 1;
}

return -1;

}

int main() {
vector<int> arr = {2, 4, 6, 8, 10, 12};
int target = 10;

cout << "Buggy Code Output: "
     << binarySearchBuggy(arr, target) << endl;

cout << "Corrected Code Output: "
     << binarySearch(arr, target) << endl;

return 0;

}
